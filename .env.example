# Spotify Level 2 (Authorization Code with PKCE) — public Vite config only.
# Copy this file to .env.local and fill in your Spotify app's Client ID.
# Redirect URI must be registered in the Spotify Developer Dashboard:
#   http://localhost:5173/board-lab
#   (optionally) http://127.0.0.1:5173/board-lab
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/board-lab
